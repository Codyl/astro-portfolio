---
import { CirclePlay } from "@lucide/astro";
---

<section class="text-primary mt-16">
  <div
    class="gap-stack-sm border-outline-variant/20 pb-stack-sm flex flex-col justify-between border-b md:flex-row md:items-end"
  >
    <h2
      class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface"
    >
      Knowledge base
    </h2>
    <p
      class="font-label-mono text-label-mono text-tertiary tracking-widest uppercase"
    >
      Engineering Insights &amp; Resources
    </p>
  </div>

  <!-- Technical Resources Section (Bento Grid) -->
  <div class="space-y-stack-lg">
    <div
      class="gap-stack-sm grid min-h-[600px] grid-cols-1 gap-4 md:grid-cols-4 md:grid-rows-2"
    >
      <!-- Resource 1 (Large) -->
      <div
        class="bg-surface-container-high glass-panel p-stack-md hover:border-tertiary/40 group flex flex-col justify-between rounded-xl transition-all md:col-span-2 md:row-span-2"
      >
        <div class="space-y-stack-sm">
          <div class="flex items-start justify-between">
            <span
              class="material-symbols-outlined text-tertiary text-4xl"
              data-icon="terminal">terminal</span
            >
            <span
              class="text-label-mono font-label-mono bg-tertiary/10 text-tertiary rounded px-2 py-1"
              >GUIDE</span
            >
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface">
            Mastering Memory Safety in Rust
          </h3>
          <p class="text-on-surface-variant text-body-md leading-relaxed">
            A comprehensive 4,000-word deep dive into the borrow checker,
            ownership, and writing blazingly fast code without the fear of
            segfaults.
          </p>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-label-mono font-label-mono text-on-surface-variant"
            >Read time: 12 min</span
          >
          <span
            class="material-symbols-outlined group-hover:text-tertiary"
            data-icon="open_in_new">open_in_new</span
          >
        </div>
      </div>
      <!-- Resource 2 (Medium) -->
      <div
        class="glass-panel bg-surface-container-high p-stack-md gap-stack-md hover:border-tertiary/40 group flex items-center rounded-xl transition-all md:col-span-2 md:row-span-1"
      >
        <div class="flex-1 space-y-2">
          <span class="text-label-mono font-label-mono text-on-surface-variant"
            >VIDEO TUTORIAL</span
          >
          <h3 class="font-headline-md text-headline-md text-on-surface text-lg">
            Next.js 14 Server Actions Patterns
          </h3>
        </div>
        <div
          class="bg-surface-container-highest flex h-24 w-24 items-center justify-center rounded-lg"
        >
          <span
            class="material-symbols-outlined text-tertiary text-3xl"
            data-icon="play_circle"><CirclePlay /></span
          >
        </div>
      </div>
      <!-- Resource 3 (Small) -->
      <div
        class="glass-panel bg-surface-container-high p-stack-md hover:border-tertiary/40 group flex flex-col justify-between rounded-xl transition-all md:col-span-1 md:row-span-1"
      >
        <span class="material-symbols-outlined text-tertiary" data-icon="book"
          >book</span
        >
        <h3 class="font-headline-md text-on-surface text-base">
          API Design Patterns
        </h3>
        <span class="text-label-mono font-label-mono text-on-surface-variant"
          >PDF • 2MB</span
        >
      </div>
      <!-- Resource 4 (Small) -->
      <div
        class="glass-panel bg-surface-container-high p-stack-md hover:border-tertiary/40 group flex flex-col justify-between rounded-xl transition-all md:col-span-1 md:row-span-1"
      >
        <span
          class="material-symbols-outlined text-tertiary"
          data-icon="code_blocks">code_blocks</span
        >
        <h3 class="font-headline-md text-on-surface text-base">
          TS Utility Types
        </h3>
        <span class="text-label-mono font-label-mono text-on-surface-variant"
          >SNIPPETS</span
        >
      </div>
    </div>
  </div>
</section>
