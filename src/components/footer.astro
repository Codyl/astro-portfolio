---
import Linkedin from "./svg/linkedin.astro";
import Github from "./svg/github.astro";
import Youtube from "./svg/youtube.astro";
import Medium from "./svg/medium.astro";
import ScrollButton from "./scroll-button";
---

<footer class="bg-surface-container-lowest text-primary mt-20 pt-8 pb-12">
  <div
    class="tablet:flex-row mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-6"
  >
    <div>
      <p class="font-semibold">Cody Lillywhite | Full Stack Developer</p>
      <p class="text-muted-foreground text-sm">
        © 2026 Cody. All rights reserved.
      </p>
    </div>

    <nav class="tablet:flex-row flex flex-col items-center gap-4">
      <ScrollButton client:idle id="about" variant="link"> About</ScrollButton>
      <ScrollButton client:idle id="projects" variant="link">
        Projects</ScrollButton
      >
      <ScrollButton client:idle id="contact" variant="link"
        >Contact</ScrollButton
      >
      <ScrollButton client:idle id="knowledge-base" variant="link"
        >Knowledge Base</ScrollButton
      >
    </nav>

    <nav class="flex items-center gap-4">
      <a href="https://github.com/Codyl"
        ><Github className="text-primary size-5" /></a
      >
      <a href="https://www.linkedin.com/in/cody-lillywhite/"
        ><Linkedin className="text-primary size-5" /></a
      >
      <a href="https://youtube.com/@codylillywhite4245"
        ><Youtube className="text-primary size-5" /></a
      >
      <a href="https://medium.com/@codylillyw"
        ><Medium className="text-primary size-5" /></a
      >
    </nav>
  </div>
</footer>
