---

---

<section class="mt-16">
  <div class="mb-6 flex items-baseline justify-between">
    <h2 class="text-2xl font-semibold">Selected Works</h2>
    <span class="text-accent text-xs uppercase"
      >A collection of digital architectures</span
    >
  </div>

  <div class="grid gap-8">
    <article class="bg-surface-2 grid gap-6 rounded-xl p-6 md:grid-cols-3">
      <div class="bg-muted overflow-hidden rounded md:col-span-2">
        <img
          src="/assets/screens/quantum-ledger.png"
          alt="Quantum Ledger preview"
          class="h-56 w-full object-cover"
        />
      </div>
      <div class="flex flex-col justify-between md:col-span-1">
        <div>
          <span class="text-muted-foreground text-xs uppercase"
            >2024 / Full-stack system</span
          >
          <h3 class="mt-2 text-xl font-bold">
            Quantum Ledger: Decentralized SaaS
          </h3>
          <p class="text-muted-foreground mt-3 text-sm">
            A high-performance financial infrastructure built with Rust and
            Next.js, featuring sub-second latency for complex global
            transactions.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="badge">Rust</span>
            <span class="badge">Next.js</span>
            <span class="badge">Postgres</span>
          </div>
        </div>
        <a
          class="text-accent mt-4 inline-flex items-center"
          href="/projects/quantum-ledger">View Case Study →</a
        >
      </div>
    </article>

    <article class="bg-surface-2 grid gap-6 rounded-xl p-6 md:grid-cols-3">
      <div class="bg-muted overflow-hidden rounded md:col-span-2">
        <img
          src="/assets/screens/nebulasrv.png"
          alt="Nebula Cloud Orchestrator preview"
          class="h-56 w-full object-cover"
        />
      </div>
      <div class="flex flex-col justify-between md:col-span-1">
        <div>
          <span class="text-muted-foreground text-xs uppercase"
            >2023 / Infrastructure</span
          >
          <h3 class="mt-2 text-xl font-bold">Nebula Cloud Orchestrator</h3>
          <p class="text-muted-foreground mt-3 text-sm">
            Custom Kubernetes automation platform designed for high-scale
            enterprise deployments, reducing operational overhead by 40%.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="badge">Go</span>
            <span class="badge">Kubernetes</span>
            <span class="badge">Terraform</span>
          </div>
        </div>
        <a
          class="text-accent mt-4 inline-flex items-center"
          href="/projects/nebula-orchestrator">View Case Study →</a
        >
      </div>
    </article>
  </div>
</section>
