---
import { Input } from "./ui/input";
import { Search, SendHorizontal, Rocket, Newspaper } from "@lucide/astro";
import { Button } from "./ui/button";
import Backdrop from "./backdrop";
---

<section
  class="relative flex h-screen items-center justify-center overflow-hidden"
>
  <Backdrop client:load />
  <div class="text-center">
    <h1
      class="text-primary text-5xl leading-none font-extrabold tracking-tight md:text-6xl"
    >
      Crafting Logic in <span class="text-accent">The Void</span>
    </h1>
    <p class="sr-only">
      Search projects, articles, and case studies — tools and writing about
      building reliable systems.
    </p>

    <div class="mt-8 flex items-center justify-center gap-3">
      <form class="w-full max-w-2xl">
        <div class="relative">
          <Input
            aria-label="Search projects, articles, or videos"
            placeholder="Search projects, articles, or videos..."
            className="bg-elevated h-12 pl-12"
          />
          <Search
            class="text-accent absolute top-1/2 left-3 -translate-y-1/2"
          />

          <Button
            type="submit"
            className="btn btn-primary absolute top-1/2 right-3 -translate-y-1/2"
          >
            Search
          </Button>
        </div>
      </form>
    </div>

    <div class="mt-6 flex items-center justify-center gap-3">
      <Button variant="outline" className="text-primary">
        <SendHorizontal class="mr-2 size-4" />
        Contact Me</Button
      >
      <Button variant="outline" className="text-primary">
        <Rocket class="mr-2 size-4" />
        Featured Projects</Button
      >
      <Button variant="outline" className="text-primary"
        ><Newspaper class="mr-2 size-4" />Latest Articles</Button
      >
    </div>
  </div>
</section>
